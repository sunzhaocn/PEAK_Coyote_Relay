# Copy to .env only for manual Compose use. deploy.sh/deploy.ps1 generate their own local configuration.
PUBLIC_PORT=443
RELAY_INTERNAL_PORT=9998
LOG_LEVEL=info

MAX_CONNECTIONS=4000
MAX_CONNECTIONS_PER_IP=64
MAX_CLIENTS_PER_CONTROLLER=16
MAX_MESSAGE_BYTES=262144
MAX_MESSAGES_PER_SECOND=120
MAX_WS_HANDSHAKES_PER_MINUTE=240
IDLE_TIMEOUT=300000

ADMIN_USER=admin
# Do not commit a real password. Replace this value before starting a public deployment.
ADMIN_INITIAL_PASSWORD=CHANGE_ME_BEFORE_DEPLOY
ADMIN_SESSION_HOURS=8
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_WINDOW_MS=600000
ADMIN_LOGIN_LOCKOUT_MS=900000
ADMIN_API_MAX_PER_MINUTE=180
ADMIN_GLOBAL_LOGIN_MAX_PER_MINUTE=60
ADMIN_ALLOW_INSECURE_HTTP=false
